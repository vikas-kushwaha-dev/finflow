APP_ENV=local
HTTP_ADDR=:8080
GATEWAY_HTTP_ADDR=:8088
LEDGER_HTTP_ADDR=:8081
DATABASE_URL=postgres://finflow:finflow@localhost:5432/finflow?sslmode=disable
MIGRATIONS_DIR=../../migrations
API_KEY=local-dev-api-key-change-me
MAX_REQUEST_BODY_BYTES=1048576
KAFKA_BROKERS=localhost:9092
PAYMENT_EVENTS_TOPIC=finflow.payment.events
PAYMENT_SERVICE_URL=http://localhost:8080
LEDGER_SERVICE_URL=http://localhost:8081
GATEWAY_RATE_LIMIT_REQUESTS=120
GATEWAY_RATE_LIMIT_WINDOW=1m
